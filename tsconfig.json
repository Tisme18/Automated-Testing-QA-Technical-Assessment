{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "paths": {
      "@pages/*": ["pages/*"],
      "@data/*": ["test-data/*"],
      "@fixtures/*": ["init/*"]
    }
  },
  "include": ["../tests/**/*", "pages/**/*", "init/**/*", "playwright.config.ts"]
}